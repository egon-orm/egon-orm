{
  "name": "egon-orm-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Egon ORM: a TypeScript ORM with schemas, changesets, composable queries and a repo (workspace root).",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=12"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:types && pnpm build",
    "lint": "biome ci --error-on-warnings . && node scripts/check-workspace-policy.mjs && node scripts/check-release-config.mjs && node scripts/check-dialect-conditionals.mjs && node scripts/check-pure-annotations.mjs && tsx scripts/dialect-support.ts --check && pnpm docs:check",
    "format": "biome check --write .",
    "typecheck": "tsc -b && pnpm typecheck:spikes",
    "typecheck:spikes": "tsc -p tsconfig.spikes.json && node scripts/check-rejected-spike.mjs",
    "test": "pnpm test:unit && pnpm test:types",
    "test:unit": "vitest run --project '*:unit' --coverage && pnpm --filter @egon-orm/benchmarks run test && node --test \"scripts/*.test.mjs\"",
    "test:types": "vitest run --project '*:types'",
    "test:integration": "vitest run --project '*:integration'",
    "test:soak": "vitest run --project postgres:soak",
    "test:mutation": "node scripts/mutation.mjs",
    "test:watch": "vitest --project '*:unit'",
    "build": "pnpm -r --filter './packages/*' run build",
    "lint:packages": "pnpm -r --filter './packages/*' run lint:package",
    "smoke": "pnpm --filter @egon-orm/example-smoke run smoke",
    "bench": "pnpm build && pnpm --filter @egon-orm/benchmarks run bench",
    "api:report": "pnpm build && node scripts/api-report.mjs --update",
    "api:check": "node scripts/api-report.mjs",
    "docs:dialects": "tsx scripts/dialect-support.ts",
    "docs:api": "pnpm --filter @egon-orm/docs-site run api",
    "docs:exports": "tsx scripts/api-index.ts",
    "docs:errors": "tsx scripts/error-docs.ts",
    "docs:check": "node scripts/check-docs.mjs && tsx scripts/api-index.ts --check && tsx scripts/error-docs.ts --check && node scripts/check-page-order.mjs && cspell --no-progress",
    "docs:dev": "pnpm --filter @egon-orm/docs-site run dev",
    "docs:build": "pnpm --filter @egon-orm/docs-site run build",
    "docs:preview": "pnpm --filter @egon-orm/docs-site run preview",
    "db:up": "docker compose up -d --wait postgres",
    "db:up:tier2": "docker compose --profile tier2 up -d --wait",
    "db:up:floors": "docker compose --profile floors up -d --wait postgres-floor mysql-floor",
    "db:down": "docker compose --profile tier2 --profile floors down --volumes --remove-orphans",
    "db:reset": "pnpm db:down && pnpm db:up",
    "clean": "node scripts/clean.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-version.mjs",
    "release:dry-run": "node scripts/release-dry-run.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@microsoft/api-extractor": "7.59.4",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "cspell": "10.3.6",
    "fast-check": "4.10.2",
    "publint": "0.3.25",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "verdaccio": "6.10.6",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
