    "@egon-orm/zod": "workspace:*",
    "arktype": "2.2.8",
    "egon-orm": "workspace:*",
    "pg": "8.23.1",
    "valibot": "1.5.0",
    "yup": "1.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "express": "5.3.0",
    "fastify": "5.12.7",
    "hono": "4.13.13",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typedoc-vitepress-theme": "1.1.4",
