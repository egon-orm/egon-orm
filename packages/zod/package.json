{
  "name": "@egon-orm/zod",
  "version": "0.0.0",
  "description": "Derive Zod schemas from Egon ORM schemas.",
  "license": "MIT",
  "author": "Casey Tickes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egon-orm/egon-orm.git",
    "directory": "packages/zod"
  },
  "homepage": "https://egon-orm.github.io/egon-orm/",
  "bugs": "https://github.com/egon-orm/egon-orm/issues",
  "keywords": [
    "orm",
    "typescript",
    "sql",
    "changeset",
    "query-builder"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "lint:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "egon-orm": "workspace:^",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "arktype": "2.2.8",
    "egon-orm": "workspace:*",
    "valibot": "1.5.0",
    "yup": "1.7.1",
    "zod": "4.6.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
