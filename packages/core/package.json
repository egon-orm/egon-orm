{
  "name": "egon-orm",
  "version": "0.1.0",
  "description": "A TypeScript ORM with schemas, changesets, composable queries and a repo, typed end to end.",
  "license": "MIT",
  "author": "Casey Tickes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egon-orm/egon-orm.git",
    "directory": "packages/core"
  },
  "homepage": "https://egon-orm.github.io/egon-orm/",
  "bugs": "https://github.com/egon-orm/egon-orm/issues",
  "keywords": [
    "orm",
    "typescript",
    "sql",
    "changeset",
    "query-builder"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/internal/index.*"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./migration": {
      "types": "./dist/migration.d.ts",
      "default": "./dist/migration/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./messages": {
      "types": "./dist/messages.d.ts",
      "default": "./dist/messages/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "lint:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/pg": "8.23.1",
    "better-sqlite3": "12.11.1",
    "mysql2": "3.24.5",
    "pg": "8.23.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
