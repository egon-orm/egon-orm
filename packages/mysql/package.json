{
  "name": "@egon-orm/mysql",
  "version": "0.1.0",
  "description": "MySQL adapter for Egon ORM.",
  "license": "MIT",
  "author": "Casey Tickes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egon-orm/egon-orm.git",
    "directory": "packages/mysql"
  },
  "homepage": "https://egon-orm.github.io/egon-orm/",
  "bugs": "https://github.com/egon-orm/egon-orm/issues",
  "keywords": [
    "orm",
    "typescript",
    "sql",
    "changeset",
    "query-builder",
    "mysql"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "lint:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "egon-orm": "workspace:^",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "egon-orm": "workspace:*",
    "mysql2": "3.24.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
