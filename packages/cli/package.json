{
  "name": "@egon-orm/cli",
  "version": "0.1.0",
  "description": "The egon command for Egon ORM: migrations and development databases.",
  "license": "MIT",
  "author": "Casey Tickes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egon-orm/egon-orm.git",
    "directory": "packages/cli"
  },
  "homepage": "https://egon-orm.github.io/egon-orm/",
  "bugs": "https://github.com/egon-orm/egon-orm/issues",
  "keywords": [
    "orm",
    "typescript",
    "sql",
    "migrations",
    "cli"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "bin": {
    "egon": "./dist/bin.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "lint:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "egon-orm": "workspace:^"
  },
  "devDependencies": {
    "@egon-orm/postgres": "workspace:*",
    "egon-orm": "workspace:*",
    "pg": "8.23.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
