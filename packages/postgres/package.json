{
  "name": "@egon-orm/postgres",
  "version": "0.1.0",
  "description": "PostgreSQL adapter for Egon ORM.",
  "license": "MIT",
  "author": "Casey Tickes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egon-orm/egon-orm.git",
    "directory": "packages/postgres"
  },
  "homepage": "https://egon-orm.github.io/egon-orm/",
  "bugs": "https://github.com/egon-orm/egon-orm/issues",
  "keywords": [
    "orm",
    "typescript",
    "sql",
    "changeset",
    "query-builder"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "lint:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "@types/pg": "^8.21.0",
    "egon-orm": "workspace:^",
    "pg": "^8.21.0",
    "pg-cursor": "^2.12.0"
  },
  "peerDependenciesMeta": {
    "@types/pg": {
      "optional": true
    },
    "pg-cursor": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/pg-cursor": "2.7.2",
    "egon-orm": "workspace:*",
    "pg": "8.23.1",
    "pg-cursor": "2.22.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
